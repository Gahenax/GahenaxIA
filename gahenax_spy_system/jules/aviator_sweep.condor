# aviator_sweep.condor - Gahenax Jules Dispatch v12.0
# Dispatcher: Antigravity AI
# Target: Aviator RNG Seed Cryptanalysis

executable     = aviator_sweep.sh
arguments      = $(Process)

# Archivos de registro y salida para monitoreo en la Gateway
output         = logs/aviator_$(Process).out
error          = logs/aviator_$(Process).err
log            = logs/aviator_$(Process).log

# Requerimientos de los drones Katsina (Forge)
request_cpus   = 4
request_memory = 16GB

# Cola de 100 tareas para barrido paralelo masivo
queue 100
