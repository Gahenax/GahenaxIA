# Gahenax Infrastructure — Environment Variables
# Copia este archivo como .env y rellena todos los valores
# cp .env.example .env && nano .env
#
# IMPORTANTE: Nunca commitear el .env — ya está en .gitignore

# ── Dominio base ──────────────────────────────────────────────
# Todos los servicios se despliegan como subdominios de este dominio
DOMAIN=gahenax.ai
# Ejemplo: git.gahenax.ai, vault.gahenax.ai, chat.gahenax.ai, etc.

# ── Wave 1: Gitea ─────────────────────────────────────────────
GITEA_DB_PASSWORD=CAMBIA_ESTO_gitea_db_pass

# ── Wave 1: Vaultwarden ───────────────────────────────────────
# Generar con: echo -n "TU_CONTRASEÑA_ADMIN" | argon2 "$(openssl rand -base64 32)" -e -id -k 65540 -t 3 -p 4
VAULTWARDEN_ADMIN_TOKEN=CAMBIA_ESTO_argon2_hash
# SMTP para emails de bienvenida/reset (usar credenciales Mailcow Wave 2)
SMTP_HOST=mail.gahenax.ai
SMTP_USERNAME=noreply@gahenax.ai
SMTP_PASSWORD=CAMBIA_ESTO_smtp_pass

# ── Wave 2: Plausible ─────────────────────────────────────────
# Generar con: openssl rand -base64 64
PLAUSIBLE_SECRET_KEY=CAMBIA_ESTO_base64_64chars
PLAUSIBLE_DB_PASSWORD=CAMBIA_ESTO_plausible_db_pass

# ── Wave 2: Activepieces ──────────────────────────────────────
# Generar con: openssl rand -hex 32
ACTIVEPIECES_JWT_SECRET=CAMBIA_ESTO_hex_32chars
ACTIVEPIECES_DB_PASSWORD=CAMBIA_ESTO_activepieces_db_pass

# ── Wave 3: Open-WebUI ────────────────────────────────────────
# Generar con: openssl rand -hex 32
OPEN_WEBUI_SECRET=CAMBIA_ESTO_open_webui_secret
# Hash para acceso externo a Ollama API (para Jules drones)
# Generar con: caddy hash-password --plaintext "TU_PASS"
OLLAMA_API_HASH=CAMBIA_ESTO_bcrypt_hash

# ── Wave 4: Grafana ───────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=CAMBIA_ESTO_grafana_pass

# ── Wave 4: Twenty CRM ───────────────────────────────────────
# Generar con: openssl rand -base64 32
TWENTY_APP_SECRET=CAMBIA_ESTO_twenty_secret
TWENTY_DB_PASSWORD=CAMBIA_ESTO_twenty_db_pass
