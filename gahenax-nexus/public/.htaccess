<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow the _next directory
  RewriteRule ^_next/(.*)$ _next/$1 [L]

  # For every page, check if it exists as a directory/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Handle trailing slashes for static export
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)/$ $1/index.html [L]

</IfModule>

<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
</IfModule>

# Security Headers (OEDA Hardening)
<IfModule mod_headers.c>
  # CSP: Allow self and Next.js internal inline scripts, block external frames and object execution.
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-OBTN3RiyCV4Bq7dFqZ5a2pAXjnCcCYeTJMO2I/LYKeo=' 'sha256-jkbv5bucxlgGHdFWNnTGyFOtXAmvPF95ETNdCnhGYjU=' 'sha256-WwTThUimx4EDkPy8+Yeq3qrMaWjJ1MSRaaV76Pv8yow=' 'sha256-ajfemlE+d5nCIG4s0mAPqt5mNglFOXYX3s04gGqdE7o=' 'sha256-DESFCzuHFZ4t/Pk+0P5ry+gUmEvtdM2nMKBJvwbhO5M=' 'sha256-qqAGRmnGQ4ul+pbdNiNu7qQiXUT2vPncoldltdsGl54=' 'sha256-v1qf4Vv1LiR5DgJ7owHTUR1dZFQ7mb95ZM0bbzEI6io=' 'sha256-HjJIdpoeO22xrU30iwXUu5Tj1/ZOy10MXUSVKtoHI3U=' 'sha256-tpDcREQ4p+FPYlHCoMmpUg7ovCgbcmHXUm2azXAiiZc=' 'sha256-DF5LyvHmoH2+ii2JkLSepakwDIu+LCGfnOM6B6gSGJA='; style-src 'self'; img-src 'self' data: https:; font-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self';"
  
  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"
  
  # Prevent Clickjacking
  Header set X-Frame-Options "DENY"
  
  # Strict Referrer Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
