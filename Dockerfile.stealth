# GAHENAX SOVEREIGN SEARCH CORE (SSC) v3.0 - STEALTH BRIEFCASE
FROM python:3.11-slim-bullseye

# Impedir prompts interactivos
ENV DEBIAN_FRONTEND=noninteractive

# Instalar dependencias de sistema y Node.js
RUN apt-get update && apt-get install -y \
    curl \
    gnupg \
    libnss3 \
    libxss1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libgtk-3-0 \
    libgbm-dev \
    libxshmfence1 \
    lsb-release \
    xdg-utils \
    wget \
    && curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Configurar directorio de trabajo
WORKDIR /app

# Copiar dependencias de Node y Python
COPY Gahenax_Omni_Scraper/package*.json ./Gahenax_Omni_Scraper/
RUN cd Gahenax_Omni_Scraper && npm install

# Instalar Chromium para Puppeteer
RUN npx playwright install-deps chromium \
    && cd Gahenax_Omni_Scraper && npx puppeteer browsers install chrome

# Copiar resto de la arquitectura
COPY Gahenax_Omni_Scraper/ ./Gahenax_Omni_Scraper/
COPY gahenax_spy_system/ ./gahenax_spy_system/

# Volumen tmpfs se montará en /spy_data desde el host para Huella Cero
RUN mkdir -p /spy_data

# Entrada por defecto: Ejecutar el motor de búsqueda
ENTRYPOINT ["node", "Gahenax_Omni_Scraper/gsk_engine.mjs"]
